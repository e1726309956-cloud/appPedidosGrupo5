rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function autenticado() {
      return request.auth != null;
    }
    function administrador() {
      return autenticado() &&
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'administrador';
    }
    function puedeAcceder(pantalla) {
      let rol = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol;
      return get(/databases/$(database)/documents/roles/$(rol)).data.pantallas[pantalla] == true;
    }
    match /usuarios/{uid} {
      allow get: if autenticado() && (request.auth.uid == uid || administrador());
      allow list: if administrador();
      // Cada usuario solo puede crear su propio perfil y únicamente con rol cliente.
      allow create: if (autenticado() && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['nombre', 'correo', 'rol']) &&
        request.resource.data.keys().hasOnly(['nombre', 'correo', 'rol']) &&
        request.resource.data.nombre is string &&
        request.resource.data.nombre.size() <= 100 &&
        request.resource.data.correo is string &&
        request.resource.data.correo == request.auth.token.email &&
        request.resource.data.rol == 'cliente') || administrador();
      allow update, delete: if administrador();
    }
    match /roles/{rol} {
      // Los usuarios autenticados pueden consultar los roles necesarios para el menú.
      allow get: if autenticado();
      allow list, create, update, delete: if administrador();
    }
    // Colección exclusiva de demostración; no contiene pedidos ni datos de clientes.
    match /ejemplos/{pantalla} {
      allow read: if autenticado() && puedeAcceder(pantalla);
      allow write: if administrador() && puedeAcceder(pantalla);
    }
    // Las colecciones futuras necesitan reglas específicas para sus datos y operaciones.
    match /{documento=**} {
      allow read, write: if false;
    }
  }
}
