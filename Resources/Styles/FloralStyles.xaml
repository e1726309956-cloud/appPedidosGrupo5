<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">
    <Color x:Key="FloralCream">#FFF9F3</Color>
    <Color x:Key="FloralGreen">#244C3A</Color>
    <Color x:Key="FloralRose">#D98C9D</Color>
    <Style x:Key="TituloFloral" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="TextColor" Value="{StaticResource FloralGreen}" />
    </Style>
    <Style x:Key="TextoFloral" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="TextColor" Value="#677369" />
        <Setter Property="LineHeight" Value="1.3" />
    </Style>
    <Style x:Key="EtiquetaFloral" TargetType="Label">
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="TextColor" Value="{StaticResource FloralGreen}" />
    </Style>
    <Style x:Key="BordeCampoFloral" TargetType="Border">
        <Setter Property="Stroke" Value="#DFE5DD" />
        <Setter Property="StrokeShape" Value="RoundRectangle 12" />
        <Setter Property="BackgroundColor" Value="#FCFDFB" />
        <Setter Property="Padding" Value="12,2" />
    </Style>
    <Style x:Key="EntradaFloral" TargetType="Entry">
        <Setter Property="FontFamily" Value="OpenSansRegular" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="TextColor" Value="{StaticResource FloralGreen}" />
        <Setter Property="PlaceholderColor" Value="#7C857D" />
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
    <Style x:Key="BotonPrincipalFloral" TargetType="Button">
        <Setter Property="BackgroundColor" Value="{StaticResource FloralGreen}" />
        <Setter Property="TextColor" Value="White" />
        <Setter Property="FontFamily" Value="OpenSansSemibold" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="MinimumHeightRequest" Value="54" />
        <Setter Property="Padding" Value="16,12" />
    </Style>
    <Style x:Key="BotonSecundarioFloral" TargetType="Button" BasedOn="{StaticResource BotonPrincipalFloral}">
        <Setter Property="BackgroundColor" Value="#FAEDF0" />
        <Setter Property="TextColor" Value="{StaticResource FloralGreen}" />
        <Setter Property="BorderColor" Value="#EDD0D7" />
        <Setter Property="BorderWidth" Value="1" />
    </Style>
    <Style x:Key="BotonEnlaceFloral" TargetType="Button" BasedOn="{StaticResource BotonPrincipalFloral}">
        <Setter Property="BackgroundColor" Value="Transparent" />
        <Setter Property="TextColor" Value="{StaticResource FloralGreen}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="MinimumHeightRequest" Value="48" />
    </Style>
</ResourceDictionary>
