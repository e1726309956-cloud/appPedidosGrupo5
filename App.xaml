<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:appPedidosGrupo5"
             x:Class="appPedidosGrupo5.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
                <ResourceDictionary Source="Resources/Styles/FloralStyles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Style TargetType="NavigationPage">
                <Setter Property="BarBackgroundColor" Value="{StaticResource FloralCream}" />
                <Setter Property="BarTextColor" Value="{StaticResource FloralGreen}" />
                <Setter Property="IconColor" Value="{StaticResource FloralGreen}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
