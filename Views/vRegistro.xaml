<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="appPedidosGrupo5.Views.vRegistro"
             Title="Crear cuenta" BackgroundColor="{StaticResource FloralCream}">
    <ScrollView>
        <VerticalStackLayout x:Name="Formulario" Padding="24,32" Spacing="24"
                             MaximumWidthRequest="480" HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="12">
                <Grid ColumnDefinitions="56,*" ColumnSpacing="14">
                    <Border BackgroundColor="#FAEDF0" StrokeThickness="0" StrokeShape="RoundRectangle 18"
                            WidthRequest="56" HeightRequest="56">
                        <Image Source="floral_mark.svg" WidthRequest="40" HeightRequest="40"
                               SemanticProperties.Description="Emblema floral" />
                    </Border>
                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="3">
                        <Label Text="FLORERÍA" FontFamily="OpenSansSemibold" FontSize="16"
                               CharacterSpacing="3" TextColor="{StaticResource FloralGreen}" />
                        <Label Text="G R U P O  5" FontSize="10" TextColor="#677369" />
                    </VerticalStackLayout>
                </Grid>
                <Label Text="Cada detalle cuenta." Style="{StaticResource TituloFloral}" Margin="0,10,0,0" />
                <Label Text="Tu próxima sorpresa empieza aquí." Style="{StaticResource TextoFloral}" />
            </VerticalStackLayout>
            <Border BackgroundColor="White" Stroke="#EAE7DF" StrokeShape="RoundRectangle 24" Padding="24">
                <VerticalStackLayout Spacing="20">
                    <VerticalStackLayout Spacing="8">
                        <BoxView Color="{StaticResource FloralRose}" HeightRequest="4" WidthRequest="36"
                                 HorizontalOptions="Start" CornerRadius="2" />
                        <Label Text="Crea tu cuenta" Style="{StaticResource TituloFloral}" FontSize="22" />
                        <Label Text="Regístrate para comenzar a elegir tus flores favoritas." Style="{StaticResource TextoFloral}" />
                    </VerticalStackLayout>
                <VerticalStackLayout Spacing="7">
                    <Label Text="Correo electrónico" Style="{StaticResource EtiquetaFloral}" />
                    <Border Style="{StaticResource BordeCampoFloral}">
                        <Entry x:Name="txtCorreo" Placeholder="nombre@correo.com"
                               Keyboard="Email" MaxLength="254" Style="{StaticResource EntradaFloral}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="7">
                    <Label Text="Contraseña" Style="{StaticResource EtiquetaFloral}" />
                    <Border Style="{StaticResource BordeCampoFloral}">
                        <Entry x:Name="txtContrasena" Placeholder="Al menos 6 caracteres"
                               IsPassword="True" Style="{StaticResource EntradaFloral}" />
                    </Border>
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="7">
                    <Label Text="Confirmar contraseña" Style="{StaticResource EtiquetaFloral}" />
                    <Border Style="{StaticResource BordeCampoFloral}">
                        <Entry x:Name="txtConfirmacion" Placeholder="Repite tu contraseña"
                               IsPassword="True" Style="{StaticResource EntradaFloral}" />
                    </Border>
                </VerticalStackLayout>
                    <Grid RowSpacing="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition />
                        </Grid.ColumnDefinitions>
                        <Button Text="Crear cuenta" Clicked="btnRegistrar_Clicked"
                                Grid.Row="0" Grid.Column="0" Style="{StaticResource BotonPrincipalFloral}" />
                    </Grid>
                    <ActivityIndicator x:Name="Indicador" IsVisible="False" IsRunning="False"
                                       Color="{StaticResource FloralGreen}" />
                </VerticalStackLayout>
            </Border>
            <Label Text="Flores para celebrar, agradecer y acompañar." Style="{StaticResource TextoFloral}" FontSize="12"
                   HorizontalTextAlignment="Center" Margin="8,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
